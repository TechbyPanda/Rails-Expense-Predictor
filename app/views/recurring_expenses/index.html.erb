<div class="page-shell">
  <div class="page-header">
    <div>
      <p class="eyebrow">Finance overview</p>
      <h1>Recurring Expenses</h1>
    </div>

    <%= link_to "Add Expense", new_recurring_expense_path, class: "primary-button" %>
  </div>

  <div class="summary-grid">
    <div class="summary-card">
      <span class="summary-label">Total recurring</span>
      <strong><%= number_to_currency(@recurring_expenses.sum(:amount), unit: "₹", precision: 2) %></strong>
    </div>
    <div class="summary-card">
      <span class="summary-label">Fixed dates</span>
      <strong><%= @recurring_expenses.count(&:fixed_date?) %></strong>
    </div>
    <div class="summary-card">
      <span class="summary-label">Entries</span>
      <strong><%= @recurring_expenses.count %></strong>
    </div>
  </div>

  <% if @recurring_expenses.any? %>
    <div class="table-wrapper">
      <table class="expense-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Interval (days)</th>
            <th>Billing Date</th>
            <th>End Date</th>
            <th>Fixed?</th>
            <th>One-time?</th>
            <th class="actions-heading">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @recurring_expenses.each do |expense| %>
            <tr>
              <td><%= expense.name %></td>
              <td><%= number_to_currency(expense.amount, unit: "₹", precision: 2) %></td>
              <td><%= expense.interval_days %></td>
              <td><%= expense.billing_date %></td>
              <td><%= expense.end_date %></td>
              <td>
                <span class="status-badge <%= expense.fixed_date ? "success" : "neutral" %>">
                  <%= expense.fixed_date ? "Yes" : "No" %>
                </span>
              </td>
              <td>
                <span class="status-badge <%= expense.one_time ? "success" : "neutral" %>">
                  <%= expense.one_time ? "Yes" : "No" %>
                </span>
              </td>
              <td class="actions-cell">
                <div class="expense-actions">
                  <%= link_to "Edit", edit_recurring_expense_path(expense), class: "expense-action expense-action-edit" %>
                  <%= button_to "Mark Paid Today", mark_paid_recurring_expense_path(expense), method: :patch, class: "expense-action expense-action-paid", form: { class: "expense-action-form", data: { turbo_confirm: "Mark #{expense.name} as paid today?" } } %>
                  <%= button_to "Delete", recurring_expense_path(expense), method: :delete, class: "expense-action expense-action-delete", form: { class: "expense-action-form", data: { turbo_confirm: "Delete #{expense.name}? This can't be undone." } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No recurring expenses yet</h2>
      <p>Add your first expense to start tracking scheduled payments.</p>
      <%= link_to "Create Expense", new_recurring_expense_path, class: "primary-button" %>
    </div>
  <% end %>
</div>