<h1>Recurring Expenses</h1>

<%= link_to "Add Expense", new_recurring_expense_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Amount</th>
      <th>Interval (days)</th>
      <th>Billing Date</th>
      <th>Fixed?</th>
    </tr>
  </thead>
  <tbody>
    <% @recurring_expenses.each do |expense| %>
      <tr>
        <td><%= expense.name %></td>
        <td>₹<%= expense.amount %></td>
        <td><%= expense.interval_days %></td>
        <td><%= expense.billing_date %></td>
        <td><%= expense.fixed_date ? "Yes" : "No" %></td>
      </tr>
    <% end %>
  </tbody>
</table>