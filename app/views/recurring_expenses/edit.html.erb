<div class="page-shell form-shell">
  <div class="panel">
    <div class="page-header compact-header">
      <div>
        <p class="eyebrow">Edit entry</p>
        <h1>Edit Recurring Expense</h1>
      </div>
    </div>

    <% if @recurring_expense.errors.any? %>
      <div class="form-errors">
        <h2><%= pluralize(@recurring_expense.errors.count, "error") %> prevented this expense from being saved:</h2>
        <ul>
          <% @recurring_expense.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @recurring_expense, class: "expense-form" do |f| %>
      <div class="form-grid">
        <div class="field">
          <%= f.label :name %>
          <%= f.text_field :name, placeholder: "Rent, internet, gym..." %>
        </div>

        <div class="field">
          <%= f.label :amount %>
          <%= f.text_field :amount, placeholder: "1999.00" %>
        </div>

        <div class="field">
          <%= f.label :interval_days %>
          <%= f.number_field :interval_days, min: 1 %>
        </div>

        <div class="field">
          <%= f.label :billing_date %>
          <%= f.date_field :billing_date %>
        </div>
      </div>

      <div class="checkbox-field">
        <%= f.check_box :fixed_date %>
        <%= f.label :fixed_date, "Fixed schedule?" %>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", recurring_expenses_path, class: "secondary-button" %>
        <%= f.submit "Add Expense", class: "primary-button" %>
      </div>
    <% end %>
  </div>
</div>
